<Window x:Class="PizzaSplit.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pizza Split Calculator" Height="345" Width="306" ResizeMode="CanMinimize">
    <Window.Background>
        <ImageBrush ImageSource="/photo_2026-09-11_20-26-49.jpg"/>
    </Window.Background>
    <Grid>
        <Grid.Background>
            <ImageBrush/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="OrderBox" HorizontalAlignment="Center" Margin="0,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="235" Height="25" RenderTransformOrigin="0.5,0.5" BorderBrush="#FFABADB3" GotFocus="OrderBox_GotFocus" Text="Order Box" VerticalContentAlignment="Center" LostFocus="OrderBox_LostFocus" TextChanged="OrderBox_TextChanged" PreviewTextInput="OrderBox_PreviewTextInput"/>
        <Label Content="Сумма заказа" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="235"/>
        <TextBox x:Name="CustomerBox" HorizontalAlignment="Center" Margin="0,115,0,0" TextWrapping="Wrap" Text="Customers Box" VerticalAlignment="Top" Height="25" Width="235" VerticalContentAlignment="Center" TextChanged="CustomerBox_TextChanged" GotFocus="CustomerBox_GotFocus" LostFocus="CustomerBox_LostFocus" PreviewTextInput="CustomerBox_PreviewTextInput"/>
        <Label Content="Количество посетителей" HorizontalAlignment="Center" Margin="0,89,0,0" VerticalAlignment="Top" Width="234"/>
        <Button x:Name="CalculateButton" Content="Рассчитать сумму на одного посетителя" HorizontalAlignment="Center" Margin="0,168,0,0" VerticalAlignment="Top" Height="35" Width="235" Click="CalculateButton_Click"/>
        <TextBlock x:Name="ResultBlock" HorizontalAlignment="Center" Margin="0,228,0,0" TextWrapping="Wrap" Text="Result Block" VerticalAlignment="Top" Width="154" Height="25" FontWeight="Bold" FontSize="18" TextAlignment="Center"/>
        <Label x:Name="OrderErrorLabel" Content="Order error label" HorizontalAlignment="Center" Margin="0,61,0,0" VerticalAlignment="Top" Width="235" FontSize="10"/>
        <CheckBox x:Name="TipsCheck" Content="Учитывать чаевые (10%)" HorizontalAlignment="Center" Margin="0,208,0,0" VerticalAlignment="Top" Width="235" Checked="CheckBox_Checked" Unchecked="TipsCheck_Unchecked"/>
        <Label x:Name="CustomersErrorLabel" Content="Customers error label" HorizontalAlignment="Center" Margin="0,140,0,0" VerticalAlignment="Top" Width="234" FontSize="10"/>
        <Button x:Name="ClearButton" Content="Очистить" HorizontalAlignment="Center" Margin="0,258,0,0" VerticalAlignment="Top" Width="154" Height="30" Click="Button_Click"/>

    </Grid>
</Window>
